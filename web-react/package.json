    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.51.0",
    "oxipng": "^1.0.1",
    "oxlint": "^1.66.0",
    "typescript": "^5.2.2",
